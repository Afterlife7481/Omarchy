#!/bin/bash
# omarchy-workspace-setup — lay out apps across workspaces the way I like them.
#
#   ws 1  browser (chromium)
#   ws 2  Telegram + Signal
#   ws 3  Cursor
#   ws 4  two terminals (foot)
#   ws 5  Proton Mail (web app)
#
# Usage: omarchy-workspace-setup
#
# Most apps open with `[workspace N silent]` so the focused workspace doesn't
# jump around while things start. Two don't cooperate with that prefix in this
# Hyprland — a `chromium --app` window (Proton Mail) comes from the shared
# chromium process, and Signal (Electron) maps too slowly — so both land on
# whatever workspace is *focused* when their window appears. They're handled
# first, in isolation: focus the target, launch, wait for the window, return to
# ws 1 — all before the `[workspace N silent]` apps start, so this brief focus
# movement can't pull those off target.
#
# Note: this only *adds* windows. Run it on a fresh Hyprland session, or close
# what you have open first, otherwise apps pile on top of existing windows.

set -euo pipefail

if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  echo "omarchy-workspace-setup: not inside a Hyprland session" >&2
  exit 1
fi

# Windows whose class matches RE (case-insensitive), currently open.
count() {
  hyprctl -j clients 2>/dev/null \
    | jq --arg re "$1" '[.[] | select(.class | test($re; "i"))] | length' 2>/dev/null \
    || echo 0
}

# Focus WS, launch CMD... through uwsm-app, wait (~20s max) for a new window of
# class RE to appear so it lands on WS rather than wherever focus goes next.
place() {
  local ws=$1 re=$2 before i
  shift 2
  before=$(count "$re")
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$ws\" })" >/dev/null
  hyprctl dispatch "hl.dsp.exec_cmd(\"uwsm-app -- $*\")" >/dev/null
  for ((i = 0; i < 40; i++)); do
    sleep 0.5
    if (( $(count "$re") > before )); then break; fi
  done
}

# Launch CMD... on workspace WS via the [workspace N silent] prefix. Works for
# native apps and single-process ones that map promptly (chromium, Telegram,
# Cursor, foot). hl.dsp.exec_cmd is Omarchy Hyprland's lua dispatch entrypoint;
# the old `hyprctl dispatch exec "[rules] cmd"` string form no longer parses.
spawn() {
  local ws=$1
  shift
  hyprctl dispatch "hl.dsp.exec_cmd(\"[workspace $ws silent] uwsm-app -- $*\")" >/dev/null
}

# ── Placed first, in isolation (see header) ────────────────────────────
place 5 'mail\.proton\.me' omarchy-launch-webapp https://mail.proton.me/u/0/inbox
place 2 'signal'           signal-desktop
hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })' >/dev/null

# ── Workspace 1 : browser ───────────────────────────────────────────────
spawn 1 chromium

# ── Workspace 2 : chat (Telegram; Signal already placed above) ─────────
spawn 2 Telegram

# ── Workspace 3 : editor ───────────────────────────────────────────────
spawn 3 cursor

# ── Workspace 4 : two terminals ────────────────────────────────────────
spawn 4 foot
spawn 4 foot

# ── Land on workspace 1 ────────────────────────────────────────────────
hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })' >/dev/null

echo "Workspaces laid out. Give the apps a few seconds to finish opening."
