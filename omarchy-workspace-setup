#!/bin/bash
# omarchy-workspace-setup — lay out apps across workspaces the way I like them.
#
#   ws 1  browser (chromium)
#   ws 2  Telegram + Signal
#   ws 3  Cursor
#   ws 4  two terminals (foot)
#   ws 5  Proton Mail (web app)
#
# Usage: omarchy-workspace-setup
#
# Windows open with `[workspace N silent]` so the focused workspace does not
# jump around while things start; we switch to workspace 1 at the end.
# Exception: Proton Mail (ws 5) is a chromium --app window that ignores that
# prefix, so it's placed by briefly focusing ws 5 while it opens — see below.
#
# Note: this only *adds* windows. Run it on a fresh Hyprland session, or close
# what you have open first, otherwise apps pile on top of existing windows.

set -euo pipefail

if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  echo "omarchy-workspace-setup: not inside a Hyprland session" >&2
  exit 1
fi

# Launch CMD... on workspace WS. uwsm-app keeps each app in its own systemd
# scope, matching how Omarchy starts GUI programs. hl.dsp.exec_cmd is the
# Lua-config dispatch entrypoint used by Omarchy's Hyprland (0.56+); the old
# `hyprctl dispatch exec "[rules] cmd"` string form no longer parses.
spawn() {
  local ws=$1
  shift
  hyprctl dispatch "hl.dsp.exec_cmd(\"[workspace $ws silent] uwsm-app -- $*\")" >/dev/null
}

# ── Workspace 1 : browser ───────────────────────────────────────────────
spawn 1 chromium

# ── Workspace 2 : chat ─────────────────────────────────────────────────
spawn 2 Telegram
spawn 2 signal-desktop

# ── Workspace 3 : editor ───────────────────────────────────────────────
spawn 3 cursor

# ── Workspace 4 : two terminals ────────────────────────────────────────
spawn 4 foot
spawn 4 foot

# ── Workspace 5 : email ────────────────────────────────────────────────
# The "Proton Mail" web app. Its window is a chromium --app window opened by
# the already-running browser process, which ignores a [workspace N silent]
# prefix on the launch command — such a window just lands on whichever
# workspace is focused when it maps. So: focus ws 5, launch, and hold focus
# there until the window appears (or a ~20s timeout); the "land on workspace 1"
# step below then takes us back. There is deliberately no persistent window
# rule for this, so launching Proton Mail from the app launcher still opens it
# on the current workspace.
hyprctl dispatch 'hl.dsp.focus({ workspace = "5" })' >/dev/null
hyprctl dispatch \
  "hl.dsp.exec_cmd(\"omarchy-launch-webapp https://mail.proton.me/u/0/inbox\")" >/dev/null
for _ in $(seq 1 40); do
  sleep 0.5
  if hyprctl clients | grep -q 'class: chrome-mail\.proton\.me'; then break; fi
done

# ── Land on workspace 1 ────────────────────────────────────────────────
hyprctl dispatch 'hl.dsp.focus({ workspace = "1" })' >/dev/null

echo "Workspaces laid out. Give the apps a few seconds to finish opening."
